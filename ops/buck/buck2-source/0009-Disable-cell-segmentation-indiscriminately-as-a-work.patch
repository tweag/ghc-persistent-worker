diff --git a/app/buck2_core/src/bzl.rs b/app/buck2_core/src/bzl.rs
index b0848292f8..2ca5d8e365 100644
--- a/app/buck2_core/src/bzl.rs
+++ b/app/buck2_core/src/bzl.rs
