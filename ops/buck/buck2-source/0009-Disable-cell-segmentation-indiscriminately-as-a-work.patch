     ) -> buck2_error::Result<Self> {
         if path.parent().is_none() {
             return Err(ImportPathError::Invalid(path).into());
@@ -67,6 +67,8 @@ impl ImportPath {
             return Err(ImportPathError::Suffix(path).into());
