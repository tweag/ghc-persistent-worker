cabal-version: 2.2
name: ghc-server
version: 0.1
synopsis: Standalone GHC build server and client
license: MIT
license-file: LICENSE
build-type: Simple

flag mwb
    description: Use mwb-customized GHC
    manual: True
    default: False

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DeriveAnyClass,
    DuplicateRecordFields,
    GADTs,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StandaloneDeriving,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

  if (flag(mwb))
      cpp-options: -DMWB -DDOWNSWEEP_CACHE -DUNIT_INDEX

library
  import: all
  ghc-options: -O2
  hs-source-dirs: lib
  exposed-modules:
    GhcClient.Run
    GhcServer.Build
    GhcServer.Build.Classify
    GhcServer.Build.Compile
    GhcServer.Build.Diff
    GhcServer.Build.Execute
    GhcServer.Build.Executor
    GhcServer.Build.ExecutorChild
    GhcServer.Build.Metadata
                    GhcServer.Build.Process
                    GhcServer.Build.ProcessChild
    GhcServer.Build.Propagate
    GhcServer.Build.Schedule
    GhcServer.Build.BytecodeMirror
    GhcServer.Build.InterpAllocations
    GhcServer.Build.SharedBytecode
    GhcServer.Cabal
    GhcServer.Cabal.ExtDeps
    GhcServer.Cabal.Setup
    GhcServer.Data.BuildEnv
    GhcServer.Data.BuildCache
    GhcServer.Data.BuildEvent
    GhcServer.Data.BuildSystem
    GhcServer.Data.Config
    GhcServer.Data.ProcessEval
    GhcServer.Data.Request
    GhcServer.Data.Unit
    GhcServer.Data.UnitConfig
    GhcServer.Cache
    GhcServer.Grpc
    GhcServer.Handler
    GhcServer.Log
    GhcServer.Optparse
    GhcServer.Path
    GhcServer.Project
    GhcServer.Run
  build-depends:
    aeson,
    async,
    buck-worker-grpc,
    buck-worker-internal,
    binary,
    buck-worker-proto,
    buck-worker-types,
    bytestring,
    Cabal,
    Cabal-syntax,
    cabal-install,
    containers,
    directory,
    extra,
    file-io,
    filepath,
    ghc,
    ghc-compact,
    ghc-paths,
    ghc-worker,
    ghc-worker-test-common,
    ghci,
    grapesy ^>=1.1,
    optparse-applicative,
    parsec,
    process,
    silently,
    stm,
    text,
    time,
    transformers,
    typed-process,
    unix

executable ghc-server
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-server
  ghc-options: -O2 -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N"
  build-depends:
    ghc-server

executable ghc-client
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-client
  ghc-options: -O2 -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N"
  build-depends:
    ghc-server

test-suite ghc-server-test
  import: all
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options: -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N"
  other-modules:
    Test.BuildTest
    Test.CabalTest
    Test.CacheTest
    Test.CompactBytecodeTest
    Test.ForkMetadataTest
    Test.ForkTest
    Test.ScheduleTest
    Test.SchedulerTest
    Test.SubprocessTest
  build-depends:
    aeson,
    async,
    buck-worker-internal,
    buck-worker-types,
    bytestring,
    containers,
    directory,
    filepath,
    ghc,
    ghc-compact,
    ghc-server,
    ghc-worker-test-common,
    hedgehog,
    process,
    tasty >= 1.5,
    tasty-hedgehog,
    temporary,
    text,
    unix
