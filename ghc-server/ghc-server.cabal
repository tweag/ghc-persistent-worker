cabal-version: 2.2
name: ghc-server
version: 0.1
synopsis: Standalone GHC build server and client
license: MIT
license-file: LICENSE
build-type: Simple

flag mwb
    description: Use mwb-customized GHC
    manual: True
    default: False

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DeriveAnyClass,
    DuplicateRecordFields,
    GADTs,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StandaloneDeriving,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

  if (flag(mwb))
      cpp-options: -DMWB -DDOWNSWEEP_CACHE -DUNIT_INDEX

library
  import: all
  ghc-options: -O2
  hs-source-dirs: lib
  exposed-modules:
  build-depends:
    aeson,
    async,
    buck-worker-grpc,
    buck-worker-internal,
    binary,
    buck-worker-proto,
    buck-worker-types,
    bytestring,
    Cabal,
    Cabal-syntax,
    cabal-install,
    containers,
    directory,
    extra,
    file-io,
    filepath,
    ghc,
    ghc-paths,
    ghc-worker,
    ghc-worker-test-common,
    grapesy ^>=1.1,
    optparse-applicative,
    parsec,
    process,
    silently,
    stm,
    text,
    time,
    transformers
