cabal-version: 2.2
name: ghc-worker
version: 0.1
synopsis: GHC persistent worker through gRPC connection
license: MIT
license-file: LICENSE
build-type: Simple

flag debug
    description: Compiled with debug mode. Dump all on failure
    manual: True
    default: False
            
common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

library
  import: all
  ghc-options: -O2
  hs-source-dirs: lib
  exposed-modules:
    GhcWorker.CompileResult
    GhcWorker.GhcHandler
    GhcWorker.Grpc
    GhcWorker.Instrumentation
    GhcWorker.Orchestration
    GhcWorker.Run
  build-depends:
    async,
    binary,
    buck-worker-grpc,
    buck-worker-internal,
    buck-worker-proto,
    buck-worker-types,
    bytestring,
    containers,
    deepseq,
    directory,
    filepath,
    ghc,
    ghc-debug-stub,
    grapesy ^>=1.0.1,
    process,
    stm,
    temporary,
    text,
    unix

  if (flag(debug))
      cpp-options: -D__DEBUG__

executable ghc-worker
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-worker
  ghc-options: -O2 -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N"
  build-depends:
    ghc-worker
